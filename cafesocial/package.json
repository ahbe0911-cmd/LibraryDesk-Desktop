{
  "name": "cafesocial",
  "version": "1.0.1",
  "description": "Standalone Persian social web workspace with CafeDesk-style phone UI, native browser context menu, fixed downloads and update checking",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "npm run icon && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.0.12",
    "sharp": "0.34.4"
  },
  "build": {
    "appId": "ir.cafesocial.desktop",
    "productName": "CafeSocial",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CafeSocial",
      "artifactName": "CafeSocial-Setup-${version}-Win10-x64.${ext}"
    }
  }
}
